<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
                             http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>poa-editor-server</display-name>

    <!-- ── 인코딩 필터 ────────────────────────────────────────────── -->
    <filter>
        <filter-name>EncodingFilter</filter-name>
        <filter-class>com.poa.editor.filter.EncodingFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>EncodingFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!-- ── CORS 필터 ────────────────────────────────────────────── -->
    <filter>
        <filter-name>CorsFilter</filter-name>
        <filter-class>com.poa.editor.filter.CorsFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>CorsFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!-- ── DocumentServlet ────────────────────────────────────── -->
    <servlet>
        <servlet-name>DocumentServlet</servlet-name>
        <servlet-class>com.poa.editor.servlet.DocumentServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DocumentServlet</servlet-name>
        <url-pattern>/poa/api/v1/documents/*</url-pattern>
    </servlet-mapping>

    <!-- ── TemplateServlet ────────────────────────────────────── -->
    <servlet>
        <servlet-name>TemplateServlet</servlet-name>
        <servlet-class>com.poa.editor.servlet.TemplateServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>TemplateServlet</servlet-name>
        <url-pattern>/poa/api/v1/templates/*</url-pattern>
    </servlet-mapping>

    <!-- ── FolderServlet ────────────────────────────────────────── -->
    <servlet>
        <servlet-name>FolderServlet</servlet-name>
        <servlet-class>com.poa.editor.servlet.FolderServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>FolderServlet</servlet-name>
        <url-pattern>/poa/api/v1/folders/*</url-pattern>
    </servlet-mapping>

    <!-- ── AdminServlet ────────────────────────────────────────── -->
    <servlet>
        <servlet-name>AdminServlet</servlet-name>
        <servlet-class>com.poa.editor.servlet.AdminServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminServlet</servlet-name>
        <url-pattern>/poa/api/v1/admin/*</url-pattern>
    </servlet-mapping>

    <welcome-file-list>
        <welcome-file>poa-editor/index.html</welcome-file>
    </welcome-file-list>

</web-app>
